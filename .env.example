LLM_KEY=
LLM_MODEL=

# URL do servidor MCP (por exemplo http://mcp:8000/mcp). Vazio roda o servidor
# no próprio processo da aplicação.
MCP_SERVER_URL=

TAVILY_API_KEY=
# Rastreamento com Langfuse (opcional; ativo quando as duas chaves existem).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# O host precisa ser o da região das chaves: https://cloud.langfuse.com (EU)
# ou https://us.cloud.langfuse.com (US). Região errada dá 401 ao exportar.
LANGFUSE_HOST=https://cloud.langfuse.com

# Rastreamento com LangSmith (opcional; o LangChain/LangGraph lê estas variáveis).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=coxinh-ia

# Provedor real de imagem (OpenRouter). Sem a chave, o provedor simulado é usado.
OPENROUTER_API_KEY=
# A variante gratuita está anunciada para sair em 28/11/2026. Modelos pagos são
# recusados, a menos que OPENROUTER_ALLOW_PAID=true.
OPENROUTER_IMAGE_MODEL=recraft/recraft-v4.1-flash-v2:free
OPENROUTER_ALLOW_PAID=false
IMAGE_STORAGE_DIR=data/images
OPENROUTER_API_KEY= 

# Persistência: sqlite (padrão, sobrevive a reinícios) ou memory.
PERSISTENCE=sqlite
DATABASE_PATH=data/coxinh.db
CHECKPOINT_DATABASE_PATH=data/checkpoints.db

# API HTTP: origens do front autorizadas por CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
